server {
    listen 80;
    listen [::]:80;
    server_name 81.70.101.100;
    client_max_body_size 100m;

    location = /_admin_auth {
        internal;
        include /etc/nginx/snippets/skills-manager-auth-request.conf;
        proxy_pass http://127.0.0.1:5555/api/internal/admin-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location = /api/internal/admin-auth { return 404; }

    location = /super-admin {
        include /etc/nginx/snippets/skills-manager-admin-proxy.conf;
        proxy_pass http://127.0.0.1:5555/super-admin;
    }

    location ^~ /super-admin/ {
        include /etc/nginx/snippets/skills-manager-admin-proxy.conf;
        proxy_pass http://127.0.0.1:5555;
    }

    location ^~ /api/super-admin/ {
        include /etc/nginx/snippets/skills-manager-admin-proxy.conf;
        proxy_pass http://127.0.0.1:5555;
    }

    # 此片段在服务器上生成，包含独立账号认证和服务端代理密钥，权限为 0600。
    location = /admin {
        include /etc/nginx/snippets/skills-manager-admin-proxy.conf;
        proxy_pass http://127.0.0.1:5555/admin/approvals;
    }

    location = /admin/ {
        include /etc/nginx/snippets/skills-manager-admin-proxy.conf;
        proxy_pass http://127.0.0.1:5555/admin/approvals;
    }

    location ^~ /admin/ {
        include /etc/nginx/snippets/skills-manager-admin-proxy.conf;
        proxy_pass http://127.0.0.1:5555;
    }

    location ^~ /api/admin/ {
        include /etc/nginx/snippets/skills-manager-admin-proxy.conf;
        proxy_pass http://127.0.0.1:5555;
    }

    location / {
        proxy_pass http://127.0.0.1:5555;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Admin-Key "";
        proxy_set_header X-Admin-User "";
        proxy_set_header X-Admin-User64 "";
        proxy_set_header Authorization "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
